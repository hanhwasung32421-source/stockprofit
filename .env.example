# --- cron 보호 ---
CRON_SECRET=another-long-random-string

# --- Supabase (Region: Seoul ap-northeast-2) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- 시세: KIS 키가 있으면 KIS, 없으면 네이버(실시간, 키 불필요) → Yahoo 폴백 ---
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ENV=real

# --- 종목 목록 동기화 (공공데이터포털 '금융위원회_KRX상장종목정보') ---
DATA_GO_KR_KEY=

# --- 텔레그램 ---
TELEGRAM_BOT_TOKEN=
# 알림을 받을 방 ID (개인 채팅은 양수, 그룹은 -100... 음수). 비워두면 봇에게 /start 보낸 방으로 자동 설정
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=another-random-string
